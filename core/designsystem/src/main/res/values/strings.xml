    <plurals name="ds_placar_sim">
        <item quantity="one">%1$d voto sim</item>
        <item quantity="other">%1$d votos sim</item>
    </plurals>
    <plurals name="ds_placar_nao">
        <item quantity="one">%1$d voto não</item>
