<?xml version="1.0" encoding="utf-8"?>
<!-- Design System. Locale base do app: pt-BR. Prefixo ds_ para não colidir com strings das features. -->
<resources>
    <!-- Locale dos números e datas: acompanha a tradução das strings, não o aparelho. -->
    <string name="ds_locale_tag" translatable="false">pt-BR</string>

    <!-- Datas (padrões de java.time) -->
    <string name="ds_data_curta_padrao">dd/MM</string>
    <string name="ds_data_longa_padrao">d \'de\' MMMM \'de\' yyyy</string>

    <!-- Dinheiro: visual -->
    <string name="ds_moeda_completa">R$ %1$s</string>
    <string name="ds_moeda_compacta_reais">R$ %1$s</string>
    <string name="ds_moeda_compacta_mil">R$ %1$s mil</string>
    <string name="ds_moeda_compacta_milhao">R$ %1$s mi</string>
    <string name="ds_moeda_compacta_bilhao">R$ %1$s bi</string>
    <string name="ds_percentual">%1$s%%</string>

    <!-- Dinheiro: por extenso abreviado, para o leitor de tela -->
    <plurals name="ds_extenso_reais">
        <item quantity="one">%1$s real</item>
        <item quantity="other">%1$s reais</item>
    </plurals>
    <string name="ds_extenso_mil_reais">%1$s mil reais</string>
    <plurals name="ds_extenso_milhoes_reais">
        <item quantity="one">%1$s milhão de reais</item>
        <item quantity="other">%1$s milhões de reais</item>
    </plurals>
    <plurals name="ds_extenso_bilhoes_reais">
        <item quantity="one">%1$s bilhão de reais</item>
        <item quantity="other">%1$s bilhões de reais</item>
    </plurals>

    <!-- Presença -->
    <plurals name="ds_presenca_resumo">
        <item quantity="one">Presente em %1$d de %2$d sessão</item>
        <item quantity="other">Presente em %1$d das últimas %2$d sessões</item>
    </plurals>
    <string name="ds_presenca_sem_dados">Sem sessões registradas</string>
    <string name="ds_presenca_faltas">%1$s; faltou %2$s</string>
    <string name="ds_presenca_ordinal">na %1$dª</string>
    <string name="ds_presenca_placar_visual">%1$d/%2$d</string>

    <!-- Listas faladas: "a, b e c" -->
    <string name="ds_lista_separador">", "</string>
    <string name="ds_lista_ultimo_separador">" e "</string>
    <string name="ds_rotulo_valor">%1$s: %2$s</string>

